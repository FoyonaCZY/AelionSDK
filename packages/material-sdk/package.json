{
  "name": "@aelionsdk/material-sdk",
  "version": "1.2.0-rc.2",
  "description": "Type-safe authoring, validation and packaging tools for Aelion materials",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FoyonaCZY/AelionSDK.git",
    "directory": "packages/material-sdk"
  },
  "keywords": [
    "aelion",
    "material",
    "shader",
    "effects"
  ],
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./author-cli": {
      "types": "./dist/cli-lib.d.ts",
      "import": "./dist/cli-lib.js"
    }
  },
  "bin": {
    "aelion-material": "./dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b",
    "cli": "corepack pnpm run build && node dist/cli.js",
    "typecheck": "tsc -b --pretty false",
    "prepack": "corepack pnpm run build && node ../../scripts/package-artifacts.mjs stage",
    "postpack": "node ../../scripts/package-artifacts.mjs clean"
  },
  "dependencies": {
    "@aelionsdk/core": "1.2.0-rc.2",
    "@aelionsdk/material-compiler": "1.2.0-rc.2",
    "ajv": "8.18.0",
    "ajv-formats": "3.0.1"
  }
}
