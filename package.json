{
  "name": "aelion-sdk",
  "version": "1.2.0-rc.2",
  "private": true,
  "description": "Browser-first real-time editing, rendering and export SDK",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FoyonaCZY/AelionSDK.git"
  },
  "homepage": "https://github.com/FoyonaCZY/AelionSDK#readme",
  "bugs": {
    "url": "https://github.com/FoyonaCZY/AelionSDK/issues"
  },
  "keywords": [
    "video",
    "audio",
    "editor",
    "webcodecs",
    "webgl",
    "webgpu"
  ],
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.test.json --pretty false",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:check": "node scripts/check-markdown-links.mjs && node scripts/check-doc-locales.mjs && node scripts/check-release-docs.mjs",
    "docs:check:built": "node scripts/check-built-doc-links.mjs && node scripts/check-api-doc-coverage.mjs",
    "docs:typecheck": "tsc -b examples/typescript --pretty false",
    "fixtures:generate": "node scripts/generate-media-fixtures.mjs",
    "material": "corepack pnpm --filter @aelionsdk/material-sdk run cli --",
    "migrate": "corepack pnpm --filter @aelionsdk/sdk run migrate --",
    "report:capability": "node scripts/capture-capability-report.mjs",
    "report:capability:matrix": "node scripts/capture-capability-matrix.mjs",
    "report:device-matrix": "node scripts/capture-device-matrix-evidence.mjs --capture",
    "report:device-matrix:check": "node scripts/capture-device-matrix-evidence.mjs",
    "report:export": "node scripts/capture-export-evidence.mjs",
    "report:vertical": "node scripts/capture-vertical-slice-evidence.mjs",
    "report:alpha": "node scripts/capture-alpha-evidence.mjs",
    "report:seek": "node scripts/capture-seek-evidence.mjs",
    "report:performance": "node scripts/capture-performance-evidence.mjs",
    "report:recovery": "node scripts/capture-recovery-evidence.mjs",
    "report:phase3:check": "node scripts/check-phase-3-evidence.mjs",
    "report:phase1:gates": "node scripts/capture-phase-1-final-gates.mjs --results reports/baseline/phase-1-gate-results.json",
    "report:phase1:blocker-template": "node scripts/create-phase-1-blocker-review.mjs --results reports/baseline/phase-1-gate-results.json",
    "report:browser:chromium": "vitest run --config vitest.browser.config.ts --reporter=json --outputFile=reports/baseline/browser-smoke-chromium.json",
    "report:browser:firefox": "vitest run --config vitest.firefox.config.ts --reporter=json --outputFile=reports/baseline/browser-smoke-firefox.json",
    "test": "vitest run && corepack pnpm --filter @aelionsdk/vite-plugin run test && corepack pnpm run test:evidence-scripts",
    "test:evidence-scripts": "node scripts/run-evidence-tests.mjs",
    "test:watch": "vitest",
    "test:schema": "node scripts/validate-material-examples.mjs && vitest run packages/project-schema",
    "schemas:check": "node scripts/check-default-schemas.mjs && node scripts/check-material-sdk-schemas.mjs",
    "compatibility:check": "node scripts/check-compatibility-matrix.mjs",
    "schemas:update": "node scripts/check-default-schemas.mjs --write && node scripts/check-material-sdk-schemas.mjs --write && prettier --write packages/sdk/src/default-schemas.ts packages/material-sdk/src/bundled-schemas.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:browser:firefox": "vitest run --config vitest.firefox.config.ts",
    "test:browser:webkit": "vitest run --config vitest.webkit.config.ts",
    "test:browser:mobile": "vitest run --config vitest.mobile.config.ts",
    "test:golden": "vitest run --config vitest.golden.config.ts",
    "test:security": "vitest run packages/project-schema/test/admission.fuzz.test.ts packages/media/test/corpus.test.ts packages/material-sdk/test/material-sdk.test.ts",
    "test:soak": "vitest run packages/audio/test/pcm-ring.test.ts packages/render-ir/test/production-soak.test.ts packages/transaction/test/soak.test.ts",
    "bench": "vitest bench --run",
    "bench:competitors": "node scripts/benchmark-competitors.mjs",
    "dev:lab": "vite --config apps/capability-lab/vite.config.ts",
    "dev:editor": "corepack pnpm --filter @aelionsdk/editor-demo dev",
    "dev:quickstart": "corepack pnpm --filter @aelionsdk/quickstart dev",
    "dev:docs": "corepack pnpm --filter @aelionsdk/docs dev",
    "build:editor": "corepack pnpm --filter @aelionsdk/editor-demo build",
    "build:quickstart": "corepack pnpm --filter @aelionsdk/quickstart build",
    "build:docs": "corepack pnpm --filter @aelionsdk/docs build",
    "ci": "corepack pnpm run release:version:check && corepack pnpm run compatibility:check && corepack pnpm run report:device-matrix:check && corepack pnpm run format:check && corepack pnpm run docs:check && corepack pnpm run docs:typecheck && corepack pnpm run build:docs && corepack pnpm run docs:check:built && corepack pnpm run schemas:check && corepack pnpm run lint && corepack pnpm run typecheck && corepack pnpm run test && corepack pnpm run test:schema && corepack pnpm run build && corepack pnpm run build:quickstart && corepack pnpm run build:editor && corepack pnpm run api:snapshot",
    "api:snapshot": "corepack pnpm --filter @aelionsdk/sdk run api:snapshot",
    "test:pack": "corepack pnpm run build && node scripts/test-package-consumer.mjs",
    "release:dry-run": "corepack pnpm run build && node scripts/release-dry-run.mjs",
    "release:pack": "node scripts/prepare-release-packages.mjs",
    "release:reproducibility": "node scripts/verify-release-reproducibility.mjs",
    "release:publish": "node scripts/publish-release-packages.mjs",
    "release:registry-smoke": "node scripts/test-registry-release.mjs",
    "release:version": "node scripts/set-release-version.mjs",
    "release:version:check": "node scripts/set-release-version.mjs --check",
    "test:consumer": "corepack pnpm run build && node scripts/test-package-consumer.mjs --browser",
    "test:phase1:final": "node scripts/run-phase-1-final-gates.mjs",
    "verify:environment": "node scripts/verify-clean-environment.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "20.19.8",
    "@vitest/browser": "3.2.7",
    "ajv": "8.18.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.8.0",
    "fast-check": "4.2.0",
    "ffmpeg-static": "5.3.0",
    "playwright": "1.62.0",
    "prettier": "3.6.2",
    "typescript": "5.8.3",
    "typescript-eslint": "8.65.0",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
